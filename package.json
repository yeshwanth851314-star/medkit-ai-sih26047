{
  "name": "medkit-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MedKit AI — Intelligent Multimodal Clinical Intake & Physician Copilot (SIH26047)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/integration/golden-path.test.ts tests/integration/supabase-diagnostic.test.ts",
    "test:integration:supabase": "vitest run tests/integration/supabase-real.test.ts",
    "test:integration:supabase:diagnostic": "vitest run tests/integration/supabase-diagnostic.test.ts",
    "test:integration:gemini": "vitest run tests/integration/gemini-live.test.ts",
    "test:integration:real": "vitest run tests/integration/supabase-real.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "package:audit": "node scripts/package-audit.mjs",
    "package:watch": "node scripts/watch-package.mjs",
    "package:watch:status": "node scripts/watch-package.mjs --status",
    "package:watch:stop": "node scripts/watch-package.mjs --stop"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
