# ==============================================================================
# MedKit AI — Environment Configuration Template
# All production secrets must be set in environment variables (Vercel / Hosting).
# Never commit real credentials or API keys to version control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="MedKit AI"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo & Fallback Mode
# Set to 'true' to enable deterministic offline fixtures for hackathon demo reliability
NEXT_PUBLIC_DEMO_MODE="true"
APP_MODE="demo" # Set to 'production' for live production security enforcement

# Session Security (Required in production: minimum 32-character high-entropy secret)
SESSION_SECRET="your-32-character-session-signing-secret-here"

# Supabase Credentials (Required for remote Postgres, Auth, and Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Provider Configuration (Google GenAI / Gemini API)
# Server-side only — never expose to client
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Logging & Telemetry Level (debug, info, warn, error)
LOG_LEVEL="info"

# ABDM / ABHA Sandbox Configuration (Server-side only — never expose to client)
# Optional: MedKit operates completely offline/locally without ABDM credentials
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway"
ABDM_CLIENT_ID="your-abdm-client-id"
ABDM_CLIENT_SECRET="your-abdm-client-secret"
ABDM_HIP_ID="IN010000001"
ABDM_HPR_ID="your-hpr-id"
