{
  "info": {
    "_postman_id": "medkit-phase-b-security-verification",
    "name": "MedKit — Phase B Security Verification",
    "description": "Adversarial security and authorization collection for SIH26047 MedKit AI Phase B Verified Healthcare Professional Onboarding",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://medkit-ai-sih26047.vercel.app",
      "type": "string"
    },
    {
      "key": "aal1Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "aal2Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "clinicianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "facilityAAdminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetProfileId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Anonymous Clinical API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Error indicates unauthenticated session', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.include('UNAUTHORIZED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients"]
        }
      }
    },
    {
      "name": "02 AAL1 Clinical Access",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test('Error code is MFA_REQUIRED', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql('MFA_REQUIRED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aal1Token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients"]
        }
      }
    },
    {
      "name": "03 AAL2 Clinical Access",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns patients data array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.patients).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aal2Token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients"]
        }
      }
    },
    {
      "name": "04 Cross-Facility Clinical Access",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Denied cross-facility access with 403 or 404', function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aal2Token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients/foreign-patient-id-facility-b",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "foreign-patient-id-facility-b"]
        }
      }
    },
    {
      "name": "05 Anonymous Approval",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"approve\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/facility-approvals/prof-mock-app-01",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "facility-approvals", "prof-mock-app-01"]
        }
      }
    },
    {
      "name": "06 Ordinary Clinician Approval",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test('Error indicates insufficient role privileges', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.include('FORBIDDEN');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clinicianToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"approve\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/facility-approvals/prof-mock-app-01",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "facility-approvals", "prof-mock-app-01"]
        }
      }
    },
    {
      "name": "07 Cross-Facility Admin Approval",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cross-facility approval denied with 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{facilityAAdminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"approve\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/facility-approvals/applicant-in-facility-b",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "facility-approvals", "applicant-in-facility-b"]
        }
      }
    },
    {
      "name": "08 Valid Facility Admin Approval",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or eligible error', function () {",
              "    pm.expect([200, 400, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{facilityAAdminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"approve\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/facility-approvals/{{targetProfileId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "facility-approvals", "{{targetProfileId}}"]
        }
      }
    },
    {
      "name": "09 Registry Fail-Closed",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registry fail-closed returns 200 recheck or expected error', function () {",
              "    pm.expect([200, 400, 502, 503]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aal1Token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/onboarding/verify-registry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "onboarding", "verify-registry"]
        }
      }
    },
    {
      "name": "10 MFA Premature State",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Premature MFA enrollment rejected with 400 or 409', function () {",
              "    pm.expect([400, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aal1Token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"enroll\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/onboarding/mfa",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "onboarding", "mfa"]
        }
      }
    }
  ]
}
